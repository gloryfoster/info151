<section id="packages" class="content-padding">
    <div id="top-content">
        <h1 class="section-title">Po<span><img src="img/packages/half-circle.svg" alt="green half-circle"></span>pular packages</h1>

        <div id="package-button-container">
            <button><img src="img/packages/arrow-left.png" alt="arrow left"></button>
            <button><img src="img/packages/arrow-right.png" alt="arrow right"></button>
        </div>
    </div>

    <ul id="package-card-container">
        <li class="package-card" id="card-1">
            <!-- <img src="img/packages/image-1.png" alt="coffee shop" class="img-scaler"> -->
            <div class="package-card-img"></div>
            <p>The basic package to start your promotion</p>

            <div class="package-status-bar">
                <ul class="user-icons">
                    <li class="icon-1"></li>
                    <li class="icon-2"></li>
                    <li class="icon-3"></li>
                </ul>
                <h4>200k+ users</h4>
                <h3>$89.00</h3>
            </div>
        </li>

        <li class="selected package-card" id="card-2">
            <!-- <img src="img/packages/image-2.jpg" alt="coffee shop" class="img-scaler"> -->
            <div class="package-card-img"></div>
            <p>The standard package to grow your business</p>

            <div class="package-status-bar">
                <ul class="user-icons">
                    <li class="icon-1"></li>
                    <li class="icon-2"></li>
                    <li class="icon-3"></li>
                </ul>
                <h4>140k+ users</h4>
                <h3>$109.00</h3>
            </div>
        </li>

        <li class="package-card" id="card-3">
            <!-- <img src="img/packages/image-3.jpg" alt="coffee shop" class="img-scaler"> -->
            <div class="package-card-img"></div>
            <p>The premium package to boost your promotion</p>

            <div class="package-status-bar">
                <ul class="user-icons">
                    <li class="icon-1"></li>
                    <li class="icon-2"></li>
                    <li class="icon-3"></li>
                </ul>
                <h4>99k+ users</h4>
                <h3>$149.00</h3>
            </div>
        </li>
    </ul>

</section>